{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bluto:command:merge-parties:v1",
  "title": "MergeParties.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "correlation_id",
    "idempotency_key",
    "source_party_ids",
    "target_party_id",
    "reason"
  ],
  "properties": {
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "source_party_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "target_party_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "expected_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}